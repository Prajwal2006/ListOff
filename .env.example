# Neon PostgreSQL — use the *pooled* connection string (host contains "-pooler") for the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string — used by migrations and the seed script.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret that unlocks the /admin knowledge-base editor. Use a long random string.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Optional: public base URL used when building share links (defaults to the request origin).
NEXT_PUBLIC_APP_URL=""
